---
source: crates/agmem-server/tests/protocol.rs
assertion_line: 108
expression: "&gated"
---
[
  {
    "name": "consolidate",
    "description": "Find what stored memory needs tidying up, and get back everything needed to do it. This decides nothing and changes nothing.\n\nCall it when memory has started to feel noisy: recall keeps returning the same claim in different words, two stored claims look like they disagree, or you are picking up a project that has accumulated a lot. It is a maintenance verb, not a search one — to find a particular claim, use `recall`.\n\nFive lists come back, every claim in each with its full text so you can judge it here:\n\n- `near_duplicates` — groups of live claims saying the same thing; merge a group with one `remember` whose `supersedes` lists every other member. `min_similarity` is the weakest pair anywhere in the group, so a low number means it chained through a middle claim.\n- `contradictions` — pairs about one subject that are close without being the same; nothing here has judged that they disagree. Read both and decide.\n- `stale_contexts` — short-lived claims recall has kept alive past their class; store a durable one again with a slower `decay_class`, `forget` scaffolding.\n- `over_full_tags` — tags carrying more live lessons than a briefing shows for one; merge as a duplicate group merges.\n- `orphan_documents` — documents no live claim cites; distil and cite one, or `forget` it with `purge: true`.\n\nEvery list can be empty, and usually some are — an empty answer means there is nothing worth your attention, not that the call failed. `scanned` says what was actually compared.\n\nThis looks in the current space only, unlike every other read here: a tidy-up should not reach the shared user space unless you name it with `space`.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "space": {
          "default": null,
          "description": "Where to look: `current`, `user`, `all`, or a space name. Defaults to\n`current` alone — unlike every other read, which also covers `user`.\nMaintenance is scoped to the project you are in unless you widen it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "ChurningDocument": {
          "description": "A title with more versions than a plan should need (#137).",
          "properties": {
            "doc_kind": {
              "$ref": "#/$defs/DocKind",
              "description": "The current version's kind."
            },
            "first_at": {
              "description": "When the first version was stored, RFC3339.",
              "type": "string"
            },
            "latest_at": {
              "description": "When the current version was stored, RFC3339.",
              "type": "string"
            },
            "newest": {
              "description": "The current version, as `episode:<id>` — what `inspect` takes; the\nolder versions are what `forget` with `purge: true` should take.",
              "type": "string"
            },
            "space": {
              "description": "The space holding them.",
              "type": "string"
            },
            "title": {
              "description": "The title every version shares.",
              "type": "string"
            },
            "versions": {
              "description": "How many documents are filed under the title.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "space",
            "title",
            "doc_kind",
            "versions",
            "newest",
            "first_at",
            "latest_at"
          ],
          "type": "object"
        },
        "Cluster": {
          "description": "Live claims close enough to be one claim.",
          "properties": {
            "max_similarity": {
              "description": "The closest pair in the cluster.",
              "format": "double",
              "type": "number"
            },
            "members": {
              "description": "The claims, strongest first — the first is the natural survivor, and\neach carries its own text so the merge can be judged rather than\nguessed.",
              "items": {
                "$ref": "#/$defs/MemoryView"
              },
              "type": "array"
            },
            "min_similarity": {
              "description": "The **weakest** similarity between any two members, not merely between\nthe two that were linked. A cluster forms transitively, so a low number\nhere means it chained: A resembles B and B resembles C, while A and C\nmay be about different things. Read it before merging the whole group.",
              "format": "double",
              "type": "number"
            },
            "space": {
              "description": "The space they are in. Ids are only meaningful inside one.",
              "type": "string"
            }
          },
          "required": [
            "space",
            "members",
            "min_similarity",
            "max_similarity"
          ],
          "type": "object"
        },
        "Contradiction": {
          "description": "Two live claims naming one subject, offered so the caller can decide which\nof them is true.",
          "properties": {
            "a": {
              "$ref": "#/$defs/MemoryView",
              "description": "The stronger claim, with its text."
            },
            "b": {
              "$ref": "#/$defs/MemoryView",
              "description": "The other one, with its text."
            },
            "shared_entities": {
              "description": "The subjects they both name — what makes them comparable at all.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "similarity": {
              "description": "How close they are. High is not evidence of agreement: measured with\nthis embedder, real contradictions score 0.92–0.97 — above the\nclustering bar — because the vector carries the subject, not the\npolarity. Read both claims.",
              "format": "double",
              "type": "number"
            },
            "space": {
              "description": "The space they are in.",
              "type": "string"
            }
          },
          "required": [
            "space",
            "shared_entities",
            "a",
            "b",
            "similarity"
          ],
          "type": "object"
        },
        "DecayClass": {
          "description": "How fast a memory fades between uses: `pinned` never, `slow` over\nmonths, `normal` over weeks (the default), `fast` over days and then\npruned at startup.",
          "enum": [
            "pinned",
            "slow",
            "normal",
            "fast"
          ],
          "type": "string"
        },
        "DocKind": {
          "description": "What a document is for (schema v9, #132): a plan, a review of code or a\ndesign, a report of what was found, a probe recording an experiment, a\nverbatim transcript, or other.",
          "enum": [
            "plan",
            "review",
            "report",
            "probe",
            "transcript",
            "other"
          ],
          "type": "string"
        },
        "Kind": {
          "description": "What a memory is. `fact`: a distilled claim about the world, the user or\nthe project. `lesson`: a procedural insight, \"X fails when Y; do Z\".\n`instruction`: a standing rule, pinned into every briefing. `summary`: a\ndigest standing in for the claims it cites; `reflect` writes it.",
          "enum": [
            "fact",
            "lesson",
            "instruction",
            "summary"
          ],
          "type": "string"
        },
        "MemoryView": {
          "description": "A memory as `inspect` renders it: the whole row, including the counters\n`recall` folds away into a score.",
          "properties": {
            "access_count": {
              "description": "How often recall has returned it.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "content": {
              "description": "The claim itself.",
              "type": "string"
            },
            "created_at": {
              "description": "When the row was written, RFC3339.",
              "type": "string"
            },
            "decay_class": {
              "$ref": "#/$defs/DecayClass",
              "description": "How fast it fades between uses."
            },
            "derived_from": {
              "description": "What this claim was reflected out of, when `reflect` wrote it: the\nmemories and episodes it was drawn from, as refs to hand straight back\nto `inspect`. Absent on a claim that cites nothing.\n\nThis is what makes a conclusion checkable rather than something to take\non faith — the evidence is named, and each piece of it has its own\nhistory to walk.",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "entities": {
              "description": "The subjects it is about.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "id": {
              "description": "The record id.",
              "type": "string"
            },
            "invalid_at": {
              "description": "When it stopped; absent while it is still live.",
              "type": [
                "string",
                "null"
              ]
            },
            "invalid_reason": {
              "description": "Why it stopped: `superseded`, `forgotten`, or `expired`.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "$ref": "#/$defs/Kind",
              "description": "What the claim is."
            },
            "last_accessed": {
              "description": "When recall last returned it, RFC3339.",
              "type": "string"
            },
            "source": {
              "description": "Where it came from: `agent`, `episode:<id>`, or `external:<origin>`.",
              "type": "string"
            },
            "space": {
              "description": "The space holding it.",
              "type": "string"
            },
            "strength": {
              "description": "Ebbinghaus stability: 1.0 when written, raised by every recall that\nreturns it. A high number on an old memory means it is still in use.",
              "format": "double",
              "type": "number"
            },
            "superseded_by": {
              "description": "The claim that corrected this one.",
              "type": [
                "string",
                "null"
              ]
            },
            "supersedes": {
              "description": "The claims this one corrected — several when it merged a duplicate\ncluster into one wording. Absent, not empty, when it corrected nothing\n(see the `derived_from` note above on why this is `Option`).",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "tags": {
              "description": "Its labels.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "valid_from": {
              "description": "When the claim started being true, RFC3339.",
              "type": "string"
            },
            "writer": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WriterView"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Who wrote the row: the MCP client, the session the write belonged to,\nand the verb that performed it. Absent on rows stored before agmem\nrecorded writers — absence means \"not recorded\", never \"unknown\nclient\" (see the `derived_from` note below on why this is `Option`)."
            }
          },
          "required": [
            "id",
            "kind",
            "content",
            "space",
            "entities",
            "tags",
            "source",
            "decay_class",
            "strength",
            "access_count",
            "last_accessed",
            "valid_from",
            "created_at"
          ],
          "type": "object"
        },
        "OrphanDocument": {
          "description": "A document nothing live cites.",
          "properties": {
            "age_days": {
              "description": "How many days it has sat uncited (#137).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "chars": {
              "description": "How many characters it has.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "created_at": {
              "description": "When it was stored, RFC3339.",
              "type": "string"
            },
            "doc_kind": {
              "$ref": "#/$defs/DocKind",
              "description": "What kind of document it is."
            },
            "episode": {
              "description": "The document's id, as `episode:<id>` — what `inspect` and `forget`\ntake.",
              "type": "string"
            },
            "space": {
              "description": "The space holding it.",
              "type": "string"
            },
            "title": {
              "description": "Its title.",
              "type": "string"
            }
          },
          "required": [
            "space",
            "episode",
            "title",
            "doc_kind",
            "chars",
            "created_at",
            "age_days"
          ],
          "type": "object"
        },
        "OverFullTag": {
          "description": "A tag whose live lessons outgrew the bound (issue #82).",
          "properties": {
            "keep": {
              "description": "The bound — what `context`'s Lessons section will show for one tag, and\nthe count a merge should aim the tag back under.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "live": {
              "description": "How many live lessons carry it.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "members": {
              "description": "The lessons, strongest first and each with its text, so the merge can\nbe judged here. Capped at the same size a duplicate cluster is; `live`\nstill counts them all.",
              "items": {
                "$ref": "#/$defs/MemoryView"
              },
              "type": "array"
            },
            "space": {
              "description": "The space the lessons are in.",
              "type": "string"
            },
            "tag": {
              "description": "The tag they share.",
              "type": "string"
            }
          },
          "required": [
            "space",
            "tag",
            "live",
            "keep",
            "members"
          ],
          "type": "object"
        },
        "SpaceScan": {
          "description": "How much of one space this pass actually looked at.",
          "properties": {
            "compared": {
              "description": "How many live memories carried a vector and were compared against each\nother. Zero means either an empty space or BM25-only mode — `note`\nsays which.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "space": {
              "description": "The space.",
              "type": "string"
            },
            "truncated": {
              "description": "Whether the space holds more live memories than one pass compares. The\nstrongest were kept; run again after acting on these.",
              "type": "boolean"
            }
          },
          "required": [
            "space",
            "compared",
            "truncated"
          ],
          "type": "object"
        },
        "StaleContext": {
          "description": "A short-lived note that outlived its class.",
          "properties": {
            "claim": {
              "$ref": "#/$defs/MemoryView",
              "description": "The claim, with its text and its counters."
            },
            "expires_in_days": {
              "description": "How much longer the automatic sweep will leave it, because every recall\nextended its horizon. A large number is the finding: this stopped being\na short-lived note some time ago.",
              "format": "double",
              "type": "number"
            },
            "idle_days": {
              "description": "How long since it was last recalled.",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "claim",
            "idle_days",
            "expires_in_days"
          ],
          "type": "object"
        },
        "WriterView": {
          "description": "Who performed the write that created a row (issue #75).",
          "properties": {
            "client": {
              "description": "The client's name from its MCP handshake; `unknown` when the session\nnever introduced itself.",
              "type": "string"
            },
            "client_version": {
              "description": "The client's version, when it offered one.",
              "type": [
                "string",
                "null"
              ]
            },
            "session": {
              "description": "The session the write belonged to.",
              "type": "string"
            },
            "tool": {
              "description": "The verb that performed the write: `remember` or `reflect`.",
              "type": "string"
            }
          },
          "required": [
            "client",
            "session",
            "tool"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "churning_documents": {
          "description": "Titles rewritten more than `CHURN_VERSIONS` times — a plan that keeps\nbeing redone (#137), most rewritten first. Nothing here acts: read the\nnewest version, `remember` or `reflect` what the versions agree on\nciting it, then `forget` the older versions with `purge: true`.",
          "items": {
            "$ref": "#/$defs/ChurningDocument"
          },
          "type": "array"
        },
        "contradictions": {
          "description": "Pairs of live claims about one subject that may disagree. Nothing here\njudges that they do — read both and decide, and expect to find some of\nthese in `near_duplicates` too: an embedding cannot tell a claim from\nits own negation, so the two lists overlap by design.",
          "items": {
            "$ref": "#/$defs/Contradiction"
          },
          "type": "array"
        },
        "near_duplicates": {
          "description": "Groups of live claims saying the same thing. Merge one by sending\n`remember` with the surviving wording and `supersedes` set to the ids\nof every other member — one call, one live claim, and each closed\nmember still readable and pointing at what replaced it. Do not reach\nfor `forget` here: that deletes the correction history a merge exists\nto keep.",
          "items": {
            "$ref": "#/$defs/Cluster"
          },
          "type": "array"
        },
        "note": {
          "description": "Present only when something limited the answer — no embedder, a\nspace larger than one pass compares, or more findings than one\nanswer carries.",
          "type": [
            "string",
            "null"
          ]
        },
        "orphan_documents": {
          "description": "Documents no live claim cites, stored more than `ORPHAN_GRACE_DAYS`\nago, newest first (#134, #137). Nothing removes these on its own: one\nmay still be waiting to be read, or its claims were closed. Distil\nwhat it still says and `remember` it citing the document, or `forget`\nit with `purge: true` if it has served.",
          "items": {
            "$ref": "#/$defs/OrphanDocument"
          },
          "type": "array"
        },
        "over_full_tags": {
          "description": "Tags holding more live lessons than the bound `context`'s Lessons\nsection keeps per tag (issue #82). Merge one the way a duplicate\ncluster merges: one `remember` with the wording worth keeping and\n`supersedes` naming the lessons it absorbs — a bounded window of\nlessons beats an unbounded pile of them.",
          "items": {
            "$ref": "#/$defs/OverFullTag"
          },
          "type": "array"
        },
        "scanned": {
          "description": "What each space held, so an empty answer can be told apart from an\nunexamined one.",
          "items": {
            "$ref": "#/$defs/SpaceScan"
          },
          "type": "array"
        },
        "spaces": {
          "description": "The spaces that were examined.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stale_contexts": {
          "description": "Short-lived notes that recall has kept alive past the point their class\nwould have expired them.",
          "items": {
            "$ref": "#/$defs/StaleContext"
          },
          "type": "array"
        }
      },
      "required": [
        "spaces",
        "scanned",
        "near_duplicates",
        "contradictions",
        "stale_contexts",
        "over_full_tags",
        "orphan_documents",
        "churning_documents"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "forget",
    "description": "Remove memories the store should no longer act on — by id when you know which, or by query when you do not.\n\nReach for `remember` with `supersedes` first: a claim that turned out to be wrong is a correction, and a correction stays readable and dated. Forget is for what should not have been stored at all — something private, something that only made sense inside one session, notes on a project that no longer exists.\n\nBy default a forgotten memory is closed, not deleted: it stops surfacing in `recall` and `context`, and stays visible to `inspect` with `forgotten` as the reason, so a mistaken forget is recoverable and an audit still adds up. `purge: true` deletes outright — the claim, its whole correction history, and for an episode its verbatim text and slices. That is unrecoverable, and it is the only way to remove something that must not stay on disk. Purging anonymous text does not purge the claims distilled from it; purging a document (an episode with a title and kind) is refused while live claims cite it, unless `cascade: true` purges those claims with it.\n\nForgetting by `query` is refused until the identical call has been made with `dry_run: true`, and a query matches on the words you write, not on their meaning — the opposite of `recall`, deliberately, so a deletion never reaches something that merely resembles what you asked for.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "cascade": {
          "default": false,
          "description": "When purging a document that live claims still cite: purge those\nclaims with it, correction history and all. Without this the purge is\nrefused and names them, so nothing is left citing text that is gone.\nOff by default.",
          "type": "boolean"
        },
        "dry_run": {
          "default": false,
          "description": "Report what would be forgotten and change nothing. Required as the\nfirst of two calls when forgetting by `query`.",
          "type": "boolean"
        },
        "ids": {
          "default": [],
          "description": "The ids to forget: `memory:<id>`, `episode:<id>`, or a bare id from a\n`recall` hit. Exact, and needs no dry run.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "purge": {
          "default": false,
          "description": "Delete outright instead of closing. Unrecoverable: it takes the\nclaim's whole correction history with it, and an episode's verbatim\ntext and slices. Off by default.",
          "type": "boolean"
        },
        "query": {
          "default": null,
          "description": "What to forget, in words, when you do not have the ids. Matched on the\nwords themselves, not on meaning — so it selects what you wrote rather\nthan what resembles it. Refused unless the identical call has already\nbeen made with `dry_run: true`.",
          "type": [
            "string",
            "null"
          ]
        },
        "space": {
          "default": null,
          "description": "Where to look: `current`, `user`, `all`, or a space name. Defaults to\n`current` and `user` together.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "ForgetMatch": {
          "description": "One row a forget selected.",
          "properties": {
            "cascaded_from": {
              "description": "For a memory pulled in by `cascade`: the document it cites, whose\npurge takes it along.",
              "type": [
                "string",
                "null"
              ]
            },
            "content": {
              "description": "The claim, or the opening of the verbatim text, cut at 300 characters.",
              "type": "string"
            },
            "derived": {
              "description": "For an episode: how many claims cite it. On anonymous text they\noutlive a purge; on a document they block it unless `cascade`, and\nthen go with it.",
              "format": "uint",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "id": {
              "description": "Its id. Pass it to `inspect` to read the whole row before deciding.",
              "type": "string"
            },
            "invalid_reason": {
              "description": "Why it is already closed, when it is — `superseded`, `forgotten`, or\n`expired`. A soft forget leaves such a row exactly as it is, so this is\nwhat explains an id in `matched` that is missing from `invalidated`.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "$ref": "#/$defs/MatchKind",
              "description": "What it is."
            },
            "space": {
              "description": "The space holding it.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "content",
            "space"
          ],
          "type": "object"
        },
        "MatchKind": {
          "description": "What a match is.",
          "oneOf": [
            {
              "const": "memory",
              "description": "A distilled claim.",
              "type": "string"
            },
            {
              "const": "episode",
              "description": "Verbatim text.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "chunks_purged": {
          "description": "How many episode slices went with the purged episodes.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "dry_run": {
          "description": "Whether this was the scope check rather than the act.",
          "type": "boolean"
        },
        "invalidated": {
          "description": "The memories closed by this call. Shorter than `matched` when\nsomething in it was already closed.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "matched": {
          "description": "Everything the request selected, whether or not it moved. A purge\nlists the correction history it pulls in, which is the blast radius\nthe dry run exists to show.",
          "items": {
            "$ref": "#/$defs/ForgetMatch"
          },
          "type": "array"
        },
        "purge": {
          "description": "Whether the rows were deleted rather than closed.",
          "type": "boolean"
        },
        "purged": {
          "description": "The memories and episodes deleted by this call.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "spaces": {
