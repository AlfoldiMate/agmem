{
  "env": {
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nu --stdin \"$CLAUDE_PROJECT_DIR/.claude/hooks/scripts/prompt-context-nudge.nu\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "nu --stdin \"$CLAUDE_PROJECT_DIR/.claude/hooks/scripts/session-start-layout.nu\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nu --stdin \"$CLAUDE_PROJECT_DIR/.claude/hooks/scripts/session-start-notebook.nu\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "nu --stdin \"$CLAUDE_PROJECT_DIR/.claude/hooks/scripts/pre-worktree-guard.nu\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "nu --stdin \"$CLAUDE_PROJECT_DIR/.claude/hooks/scripts/pre-read-guard.nu\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "nu --stdin \"$CLAUDE_PROJECT_DIR/.claude/hooks/scripts/pre-read-guard.nu\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "nu --stdin \"$CLAUDE_PROJECT_DIR/.claude/hooks/scripts/post-bash-nudges.nu\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "outputStyle": "ctx-flow"
}